
#include <stdio.h>
#include <stdlib.h>

int main() {
     
    int n;
    int *numbers;
    int sum;
    int count;
    
    printf("Enter the address spacing:");
    scanf("%d",&n);
    
    numbers=calloc(n,sizeof(int));
    
    for(int i=0; i<n;i=i+1){
        printf("enter your numbers:");
        scanf("%d",&numbers[i]);
    }
    count=0;
    for(int i=0;i<n;i=i+1){
        printf("the numbers is:%d \n",numbers[i]);
        count=count+numbers[i];
    }
    sum=count;
    printf("the sum of integers is:%d",sum);

    free(numbers);
    return 0;
}
